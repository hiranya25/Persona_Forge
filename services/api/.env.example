# Copy to .env for running the API outside Docker. Docker Compose sets these itself.
DATABASE_URL=postgresql+asyncpg://pf_app:pf_app@localhost:5432/personaforge
MIGRATION_DATABASE_URL=postgresql+asyncpg://pf_owner:pf_owner@localhost:5432/personaforge
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
WEB_ORIGIN=http://localhost:5173
EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
