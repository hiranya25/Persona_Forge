# Copy this file to .env and fill in your real values.
# NEVER commit .env — it holds your real SMTP password. .gitignore already
# excludes it, and app.py refuses to start if these are missing so you
# can't accidentally deploy with blank credentials.

PORT=4000

# The exact URL your frontend is served from, so only your own site can
# use this backend to send mail. Use your real domain once deployed,
# e.g. https://personaforge.com. For local testing against
# `python3 -m http.server 8000`, use http://localhost:8000
ALLOWED_ORIGIN=http://localhost:8000

# --- Your SMTP account -------------------------------------------------
# Any provider works — this is the same info you'd type into a normal
# email client's account settings.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# SMTP_SECURE=true  -> connect over SSL/TLS from the start (usually port 465)
# SMTP_SECURE=false -> plain connection upgraded with STARTTLS (usually port 587)
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password-or-app-password

# Where form submissions and waitlist notifications get delivered.
# Usually the same as SMTP_USER, but doesn't have to be.
OWNER_EMAIL=you@example.com
